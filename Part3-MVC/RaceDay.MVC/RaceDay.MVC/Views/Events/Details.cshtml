@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Name;
    var ev = Model.Event;
    var past = ev.Date < DateTime.Now;
}
<div class="container mt-4">
    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">&larr; Back to events</a>

    <div class="rd-card mt-3">
        <partial name="_EventBanner" model="ev" />
        <div class="p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start">
                <div>
                    <h1 class="mb-1">@ev.Name</h1>
                    <div class="text-muted">@ev.Date.ToString("dddd, dd MMMM yyyy HH:mm") &middot; @ev.Location</div>
                </div>
                <div>
                    <span class="rd-role-pill">@ev.EventType</span>
                    @if (ev.DistanceKm.HasValue)
                    {
                        <span class="ms-2 fw-semibold">@ev.DistanceKm.Value.ToString("0.##") km</span>
                    }
                </div>
            </div>
            <p class="mt-3">@(string.IsNullOrWhiteSpace(ev.Description) ? "No description has been added yet." : ev.Description)</p>
            <p class="small text-muted mb-0">@ev.EnrolmentCount enrolled so far</p>
        </div>
    </div>

    <h2 class="mt-4">Categories</h2>

    @if (Model.IsParticipant && Model.MyEnrolment != null)
    {
        <div class="alert alert-success">
            You are enrolled in <strong>@Model.MyEnrolment.Category</strong>
            <partial name="_StatusBadge" model="Model.MyEnrolment.Status" />
            &middot; <a asp-controller="Participant" asp-action="MyEnrolments">View my enrolments</a>
        </div>
    }
    else if (past)
    {
        <div class="alert alert-secondary">This event has already taken place, so enrolment is closed.</div>
    }

    @if (!Model.Categories.Any())
    {
        <div class="rd-card p-4">The organiser has not added any categories yet.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var c in Model.Categories)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="rd-card rd-card-accent p-3 h-100">
                        <h3 class="mb-1">@c.Name</h3>
                        <div class="text-muted mb-3">@c.DistanceKm.ToString("0.##") km</div>
                        @if (Model.IsParticipant && Model.MyEnrolment == null && !past)
                        {
                            <form asp-controller="Participant" asp-action="Enrol" method="post">
                                <input type="hidden" name="categoryId" value="@c.Id" />
                                <input type="hidden" name="eventId" value="@ev.Id" />
                                <button type="submit" class="btn btn-rd btn-sm">Enrol in this category</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>