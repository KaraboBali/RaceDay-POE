@{
    ViewData["Title"] = "Home";
    var loggedIn = Context.Session.IsLoggedIn();
}

<section class="rd-hero">
    <div class="container">
        <h1>Find your next<br /><span>finish line.</span></h1>
        <p class="mt-3">RaceDay brings runners, cyclists and organisers together. Discover events, enrol in seconds and track every result.</p>
        <div class="mt-4">
            @if (!loggedIn)
            {
                <a class="btn btn-rd btn-lg me-2" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
            }
            else
            {
                <p class="mb-0 fw-semibold">Welcome back, @Context.Session.CurrentName().</p>
            }
        </div>
    </div>
</section>

<div class="container mt-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="rd-card rd-card-accent p-4 h-100">
                <h3>Discover events</h3>
                <p class="mb-0">Browse upcoming runs, rides and walks, filtered by type, name and date.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-card rd-card-accent p-4 h-100">
                <h3>Enrol instantly</h3>
                <p class="mb-0">Pick your category and your place is recorded immediately.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-card rd-card-accent p-4 h-100">
                <h3>Track your results</h3>
                <p class="mb-0">See your finish time and position as soon as organisers publish them.</p>
            </div>
        </div>
    </div>
</div>