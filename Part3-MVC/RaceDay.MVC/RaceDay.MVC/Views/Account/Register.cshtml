@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="container">
    <div class="rd-auth">
        <div class="rd-card rd-card-accent p-4">
            <h2 class="mb-3">Join RaceDay</h2>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Full name</label>
                    <input asp-for="Name" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Repeat password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">I want to</label>
                    <div class="row g-2">
                        <div class="col-6 rd-role-option">
                            <input type="radio" asp-for="Role" value="Participant" id="rolePart" />
                            <label for="rolePart">Take part in events</label>
                        </div>
                        <div class="col-6 rd-role-option">
                            <input type="radio" asp-for="Role" value="Organiser" id="roleOrg" />
                            <label for="roleOrg">Organise events</label>
                        </div>
                    </div>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-rd w-100">Create account</button>
            </form>
            <p class="mt-3 mb-0 text-center">Already registered? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
