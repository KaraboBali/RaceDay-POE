@model EventFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Create event" : "Edit event";
}
<div class="container mt-4" style="max-width:760px">
    <h1>@(isNew ? "Create event" : "Edit event")</h1>

    <div class="rd-card rd-card-accent p-4">
        <form asp-action="@(isNew ? "CreateEvent" : "EditEvent")" asp-route-id="@(isNew ? (int?)null : Model.Id)"
              method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Event name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="Date">Date and time</label>
                    <input type="datetime-local" id="Date" name="Date" class="form-control"
                           value="@(Model.Date?.ToString("yyyy-MM-ddTHH:mm"))" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="EventType">Event type</label>
                    <select id="EventType" name="EventType" class="form-select">
                        @foreach (var t in new[] { "Run", "Walk", "Cycle" })
                        {
                            <option value="@t" selected="@(Model.EventType == t)">@t</option>
                        }
                    </select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="DistanceKm">Distance (km)</label>
                    <input type="number" step="0.01" min="0" id="DistanceKm" name="DistanceKm" class="form-control"
                           value="@(Model.DistanceKm?.ToString("0.##"))" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Event banner (JPG, PNG or WEBP, up to 5 MB)</label>
                @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                {
                    <div class="mb-2">
                        <img src="@Url.Action("Show", "Image", new { url = Model.ExistingBannerUrl })" alt="Current banner"
                             style="max-height:140px;border-radius:10px" />
                        <div class="small text-muted">Choose a new file below to replace this banner.</div>
                    </div>
                }
                <input type="file" name="BannerFile" accept="image/jpeg,image/png,image/webp" class="form-control" />
            </div>

            <button type="submit" class="btn btn-rd">@(isNew ? "Create event" : "Save changes")</button>
            <a class="btn btn-outline-secondary ms-2" asp-action="Events">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}