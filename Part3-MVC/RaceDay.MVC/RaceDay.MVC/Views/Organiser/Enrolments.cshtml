@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
}
<div class="container mt-4">
    <a asp-action="Events" class="text-decoration-none">&larr; Back to my events</a>
    <h1 class="mt-2">Enrolments</h1>
    <p class="text-muted">@Model.Event.Name &middot; @Model.Event.Date.ToString("dd MMM yyyy")</p>

    @if (!Model.Enrolments.Any())
    {
        <div class="rd-card p-5 text-center">Nobody has enrolled yet.</div>
    }
    else
    {
        <div class="rd-card table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Participant</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Enrolments)
                    {
                        <tr>
                            <td class="fw-semibold">@e.Participant</td>
                            <td>@e.Category</td>
                            <td>@e.EnrolmentDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td class="text-end">
                                <form asp-action="SetStatus" method="post" class="d-inline">
                                    <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                    <input type="hidden" name="id" value="@e.Id" />
                                    @if (e.Status == "Confirmed")
                                    {
                                        <input type="hidden" name="status" value="Pending" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Set to pending</button>
                                    }
                                    else
                                    {
                                        <input type="hidden" name="status" value="Confirmed" />
                                        <button type="submit" class="btn btn-sm btn-rd">Confirm</button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>